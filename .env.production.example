# HuaJian_Pay — production environment template
# Usage:
#   cp .env.production.example .env
#   chmod 600 .env
#   # edit APP_URL / secrets / channel keys
#   docker compose --profile web up -d --build
#
# NEVER commit real .env

APP_NAME=HuaJian_Pay
APP_ENV=production
# Must be public HTTPS origin (Alipay/WeChat notify depend on it)
APP_URL=https://pay.example.com
# Long random secret
APP_SECRET=replace-with-long-random-secret

HOST=0.0.0.0
PORT=8080

# mock | alipay | wxpay  — do not leave mock in production
CHANNEL_MODE=alipay

DB_DRIVER=sqlite
DB_DSN=/data/huajian_pay.db

ADMIN_USERNAME=admin
# Only used to seed empty DB; change after first login
ADMIN_PASSWORD=replace-with-strong-password

PLATFORM_PID=1000
PLATFORM_KEY=replace-with-strong-merchant-key

# --- Compose host bind (optional) ---
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8080
ADMIN_HOST_BIND=0.0.0.0
ADMIN_HOST_PORT=8088

# --- Alipay RSA2 (full PEM, may include BEGIN/END) ---
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# Empty → {APP_URL}/channels/alipay/notify
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_ACCOUNT=

# --- WeChat Pay APIv3 Native (official merchant only) ---
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_APIV3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
# Empty → {APP_URL}/channels/wxpay/notify
WECHAT_NOTIFY_URL=
