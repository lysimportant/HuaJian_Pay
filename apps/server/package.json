{
  "name": "@huajian/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "HuaJian_Pay payment backend (Fastify + Drizzle)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
