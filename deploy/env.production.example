# HuaJian_Pay - production env (Docker API only)
# Domain: https://pay.sui.lianghj.top
#
# This file is tracked in git. Dotfiles are hidden by plain `ls`;
# use: ls -la   or   cat .env.production.example
# Same content is also at: deploy/env.production.example
#
#   cp .env.production.example .env
#   # or: cp deploy/env.production.example .env
#   chmod 600 .env
#   # edit secrets + channel keys
#   docker compose up -d --build
#   # host Nginx TLS + Admin static -> deploy/nginx-host.conf
#
# NEVER commit real .env

APP_NAME=HuaJian_Pay
APP_ENV=production
APP_URL=https://pay.sui.lianghj.top
APP_SECRET=replace-with-long-random-secret

HOST=0.0.0.0
PORT=8080

# mock | alipay | wxpay
CHANNEL_MODE=alipay

DB_DRIVER=sqlite
DB_DSN=/data/huajian_pay.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

PLATFORM_PID=1000
PLATFORM_KEY=replace-with-strong-merchant-key

# Compose publish (API only on loopback)
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8080

# --- Alipay RSA2 ---
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_ACCOUNT=

# --- WeChat Pay APIv3 Native ---
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_APIV3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_PLATFORM_PUBLIC_KEY=
WECHAT_NOTIFY_URL=
