# HuaJian_Pay environment template — copy to .env and fill real values
# NEVER commit real secrets

APP_NAME=HuaJian_Pay
APP_ENV=local
APP_URL=http://localhost:8080
APP_SECRET=change-me
HOST=0.0.0.0
PORT=8080

# Channel adapter: mock | alipay | wxpay
CHANNEL_MODE=mock

# Database
DB_DRIVER=sqlite
DB_DSN=./data/huajian_pay.db
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=huajian_pay
# DB_USER=root
# DB_PASS=

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Alipay (fill when channel enabled)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
# Optional: settle / receive account display
ALIPAY_ACCOUNT=

# WeChat Pay APIv3 Native — official merchant only (NOT personal QR monitoring)
# Notify path: POST /channels/wxpay/notify
WECHAT_MCH_ID=
WECHAT_APP_ID=
# Secret: APIv3 key exactly 32 bytes — never log or GET-echo
WECHAT_APIV3_KEY=
# Alias also accepted: WECHAT_API_V3_KEY=
# Merchant API certificate serial number
WECHAT_SERIAL_NO=
# Merchant private key PEM (PKCS#8). Prefer env or admin UI storage; optional path:
WECHAT_PRIVATE_KEY=
WECHAT_PRIVATE_KEY_PATH=
# WeChat platform public key / certificate PEM (for notify signature verify)
WECHAT_PLATFORM_PUBLIC_KEY=
# Public HTTPS notify, e.g. https://pay.example.com/channels/wxpay/notify
WECHAT_NOTIFY_URL=

# YiPay-compatible merchant defaults (platform side)
PLATFORM_PID=1000
PLATFORM_KEY=change-me-merchant-key
