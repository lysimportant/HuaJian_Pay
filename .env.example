# HuaJian_Pay environment template — copy to .env and fill real values
# NEVER commit real secrets

APP_NAME=HuaJian_Pay
APP_ENV=local
APP_URL=http://localhost:8080
APP_SECRET=change-me
HOST=0.0.0.0
PORT=8080

# Channel adapter: mock | alipay | wxpay
# wxpay = WeChat Pay APIv3 Native (official merchant certs required)
CHANNEL_MODE=mock

# Database
DB_DRIVER=sqlite
DB_DSN=./data/huajian_pay.db
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=huajian_pay
# DB_USER=root
# DB_PASS=

# Admin bootstrap
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Alipay (fill when CHANNEL_MODE=alipay or alipay orders)
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
# Optional: settle / receive account display
ALIPAY_ACCOUNT=

# WeChat Pay APIv3 Native — official merchant only (NOT personal QR monitoring)
# Guide: docs/wechat-pay.md
# Default notify: {APP_URL}/channels/wxpay/notify
# Admin: GET/PUT /admin/api/channels/wxpay (secrets never echoed on GET)
WECHAT_MCH_ID=
WECHAT_APP_ID=
# Secret — never log or GET-echo (alias: WECHAT_API_V3_KEY)
WECHAT_APIV3_KEY=
WECHAT_SERIAL_NO=
# Merchant API private key PEM text
WECHAT_PRIVATE_KEY=
# WeChat platform public key PEM (callback signature verify)
WECHAT_PLATFORM_PUBLIC_KEY=
# Optional override; empty → {APP_URL}/channels/wxpay/notify
WECHAT_NOTIFY_URL=
# Optional file paths (if used by deployment tooling)
# WECHAT_CERT_PATH=
# WECHAT_KEY_PATH=
# WECHAT_PRIVATE_KEY_PATH=

# YiPay-compatible merchant defaults (platform side)
PLATFORM_PID=1000
PLATFORM_KEY=change-me-merchant-key
