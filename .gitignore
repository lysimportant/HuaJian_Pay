# Local env & secrets
.env
.env.local
.env.*.local
*.pem
*.key
!*.key.example
# Allow committed E2E-only WeChat APIv3 RSA fixtures (never production secrets)
!scripts/fixtures/wechat-apiv3/*.pem

# Local SQLite / runtime data
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Node / frontend
node_modules/
dist/
build/
.output/
.cache/
coverage/
.pnpm-store/

# Logs & OS
*.log
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test / temp (task-scoped only; never ship product artifacts)
.tmp/
.tmp*
tmp/
.turbo/
*.tmp
.tmp-team-msg.json

# TypeScript emit / incremental (never commit)
*.tsbuildinfo
**/*.tsbuildinfo

# Accidental tsc emit next to Vue/TS sources
apps/admin/src/**/*.js
apps/admin/src/**/*.js.map
apps/*/dist/
packages/*/dist/
.vite/

# Nested npm lockfiles (repo uses root pnpm-lock.yaml)
package-lock.json
apps/**/package-lock.json

# Local one-off admin measure scripts
measure-*.mjs
apps/admin/scripts/measure-*.mjs
